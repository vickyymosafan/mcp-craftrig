# Workspace root. Defaults to the current working directory of the MCP process.
CRAFTRIG_WORKSPACE_ROOT=.
CRAFTRIG_STATE_DIR=.craftrig
CRAFTRIG_MAX_PARALLEL_TASKS=4
CRAFTRIG_MAX_REPAIR_ITERATIONS=5
CRAFTRIG_BROWSER_TIMEOUT_MS=20000

